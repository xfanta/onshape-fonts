# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor scratch
.idea/
.vscode/
*.swp
*.swo

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini

# Local AI / agent state and hint files (Claude Code, Cursor, etc.)
.claude/
AGENTS.md
CLAUDE.md

# Design source files — kept locally for editing, not part of the
# published repo. Public-facing assets live under /public.
/design/

# Local archives / scratch zips
*.zip
